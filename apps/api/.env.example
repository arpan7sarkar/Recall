# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Required for API readiness and Prisma migrations
DATABASE_URL=postgresql://recall:recall@localhost:5432/recall?schema=public
REDIS_URL=redis://localhost:6379

# Browser and extension origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
READINESS_TIMEOUT_MS=3000

# Clerk authentication
CLERK_SECRET_KEY=
CLERK_CLOCK_SKEW_MS=15000

# Optional enrichment services
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=second-brain

# Optional Cloudflare R2 storage
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=

# Upload validation
MAX_FILE_UPLOAD_MB=20
